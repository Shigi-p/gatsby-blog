---
import PostList from "../components/PostList.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import { getPostsNewestFirst } from "../lib/permalinks";
import { site } from "../lib/site";

const latestPosts = (await getPostsNewestFirst()).slice(0, 5);
---

<BaseLayout>
  <section class="hero">
    <h1 class="page-title">{site.hero.heading}</h1>
    {site.hero.body.map((line) => <p>{line}</p>)}
  </section>
  <section>
    <h2>Latest Posts</h2>
    <PostList posts={latestPosts} />
    <p><a href="/blog">すべての記事</a></p>
  </section>
</BaseLayout>
